# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/lolipop/
/lolipop-apps/
/lagado/
/lagado-wakasa-uploads.zip
/lagado-wakasa-uploads/
.lolipop-skip-*/

# production
/build

# misc
.DS_Store
*.pem
public/videos/*.mov
public/videos/*.m4v

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server.log
.dev-server.pid

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Basic auth (never commit)
**/.htpasswd
.lolipop-private-auth/
