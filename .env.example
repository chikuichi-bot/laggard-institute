# 管理用パスワード（iPhone から追加するときに使う）
ADMIN_SECRET=ここに好きなパスワードを設定

# Stripe カード決済
# ダッシュボード: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook（決済完了 → 売約済みに自動更新）
# エンドポイント: https://あなたのドメイン/api/stripe/webhook
# イベント: checkout.session.completed
# ローカル確認: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
