# Copy to .env.local（Git 除外）and restart `npm run dev`.
GEMINI_API_KEY=
# Optional override for native device auth (default built-in token is fine for Lagado).
# MISHIRANU_DEVICE_TOKEN=

# 駅案内の共有キャッシュ（さくらのレンタルサーバ）。未設定なら毎回生成する。
# 置き方は sakura/README-UPLOAD.txt
# MISHIRANU_CACHE_URL=https://example.sakura.ne.jp/mishiranu-cache
# MISHIRANU_CACHE_TOKEN=
